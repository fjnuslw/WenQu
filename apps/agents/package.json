{
  "name": "get-offer-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "get_offer 面试/拷打 agent 运行时（基于 pi 生态，spec §2.1）",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "npm run build --silent && node --test --test-isolation=none dist/interview/interview.test.js dist/interview/session.test.js dist/interview/eval-fixtures.test.js dist/tools/grill-repo.test.js",
    "eval:f3": "tsx scripts/eval-interview-decisions.ts",
    "eval:f3:performance": "tsx scripts/eval-interview-performance.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@hono/node-server": "2.1.1",
    "cheerio": "^1.0.0",
    "hono": "4.13.5",
    "typebox": "1.3.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
