# 复制为 .env 后填写。所有变量前缀 GETOFFER_，嵌套字段用 __
# 端口使用冷门段（23480-23482 / 24432 / 27700 / 26379），start.ps1 启动前会逐一探测占用
GETOFFER_DATABASE_URL=postgresql+asyncpg://getoffer:getoffer@localhost:24432/getoffer
GETOFFER_MEILISEARCH_URL=http://127.0.0.1:27700
GETOFFER_MEILISEARCH_KEY=getoffer_dev_master_key_change_me_32
GETOFFER_REDIS_URL=redis://localhost:26379/0
GETOFFER_DATA_DIR=data

# LLM 供应商（显式配置，网关不做跨供应商降级，见 docs/spec.md §7）
# DeepSeek-V4-Flash-Vision-Exp 为实验模型；若 API 校验模型 id 大小写，改为全小写 deepseek-v4-flash-vision-exp
GETOFFER_LLM__NAME=deepseek
GETOFFER_LLM__BASE_URL=https://api.deepseek.com/v1
GETOFFER_LLM__MODEL=deepseek-v4-flash-vision-exp
GETOFFER_LLM__API_KEY=

# G1 v2 代码语义检索（与聊天 LLM 完全分离）。disabled 时仍保留 repo map/精确搜索，
# Web 和 Agent 会明确隐藏 semantic_search，不会用关键词结果冒充语义召回。
GETOFFER_EMBEDDING__PROVIDER=disabled
GETOFFER_EMBEDDING__BASE_URL=
GETOFFER_EMBEDDING__API_KEY=
GETOFFER_EMBEDDING__MODEL=
# 0 表示由首次响应确定；同一项目索引内仍会严格校验一致。
GETOFFER_EMBEDDING__DIMENSION=0
GETOFFER_EMBEDDING__BATCH_SIZE=32
GETOFFER_EMBEDDING__TIMEOUT_SECONDS=45

# 高质量中文 TTS。disabled 时 Web 显式使用浏览器系统音色。
# openai_compatible: POST {BASE_URL}/audio/speech；cosyvoice: 官方 /inference_sft raw PCM。
GETOFFER_TTS__PROVIDER=disabled
GETOFFER_TTS__BASE_URL=
GETOFFER_TTS__API_KEY=
GETOFFER_TTS__MODEL=
GETOFFER_TTS__VOICE=
GETOFFER_TTS__RESPONSE_FORMAT=mp3
GETOFFER_TTS__TIMEOUT_SECONDS=45
# CosyVoice raw PCM 的服务采样率；其他 Provider 忽略。
GETOFFER_TTS__SAMPLE_RATE=22050

# 开发期自动建表；正式迁移用 alembic（README）
GETOFFER_AUTO_CREATE_TABLES=1

# git 克隆代理（GitHub 直连不稳时配置，如 http://127.0.0.1:7897）
GETOFFER_GIT_PROXY=
